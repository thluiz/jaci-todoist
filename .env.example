# Copy to .env, fill in, and chmod 600. Never commit .env — this repo is public.

# Todoist API token for the account whose projects are exposed.
# Todoist → Settings → Integrations → Developer → API token.
# It grants full access to that account: the allow-list in acl.json is what
# narrows it down, so the token and the ACL are equally sensitive.
TODOIST_TOKEN=

# Where to listen. Loopback only — reaching this service goes through nginx.
PORT=8008
HOST=127.0.0.1

# Principals and their project scopes. See acl.example.json.
# Edits take effect without a restart: the file is re-read when its mtime moves.
ACL_PATH=./acl.json

# Audit trail: one NDJSON file per day.
LOG_DIR=./logs
LOG_RETENTION_DAYS=30

# Ceiling on mutating calls per principal. Sized to stop a looping agent, not a
# person: a human never issues twenty writes in a minute, an agent in a retry
# loop issues a thousand.
MAX_WRITES_PER_MIN=20
MAX_WRITES_PER_DAY=200

# Upstream request timeout.
TODOIST_TIMEOUT_MS=20000
