# nginx route for jaci-todoist — one location per principal.
#
# Copy to the agent-facing listener's route directory, substitute the real keys,
# and reload. On this host that is:
#   /etc/nginx/hermes-routes/agent/todoist.conf   (served only on 127.0.0.1:8090)
#
# The rendered file holds real API keys, so it is gitignored here. Only this
# template is versioned.
#
# ── Why the key is injected here ──────────────────────────────────────────
#
# The consuming agent never holds its own API key. nginx stamps it, and
# proxy_set_header replaces whatever the client sent, so a caller cannot promote
# itself by supplying a different one. The proof of identity is the path it
# arrived on, not a value it chose.
#
# This matters because an agent with a shell can read its own configuration
# file. A key stored in the agent's config is a key the agent can exfiltrate or
# reuse against another route; a key it never receives is neither.
#
# The containment it buys is real but bounded: any process that can reach this
# listener can call every location on it. So a principal is only meaningfully
# separated from a *narrower* one if the narrower principal cannot open sockets.
# Give the broad scope to the consumer that has shell access, never the reverse.
#
# ── Adding another consumer ───────────────────────────────────────────────
#
# 1. Add a principal to acl.json with a fresh random key and its project scope.
# 2. Copy a block below, change the path segment and the key.
# 3. nginx -t && systemctl reload nginx
# 4. Point the consumer at http://127.0.0.1:8090/api/todoist/<segment>/mcp
#
# No code change, no restart of the service: acl.json is re-read when it moves.

location /api/todoist/thiago/ {
    # Trailing slash on both sides strips the prefix:
    #   /api/todoist/thiago/mcp  ->  /mcp
    proxy_pass http://127.0.0.1:8008/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;

    # Identity. Replaces any X-Api-Key the caller sent.
    proxy_set_header X-Api-Key __API_KEY_THIAGO__;

    # Required for the MCP SSE keep-alive on GET /mcp.
    proxy_set_header Connection '';
    proxy_buffering off;

    client_max_body_size 1m;
    proxy_read_timeout 60s;
    proxy_connect_timeout 10s;
}

location /api/todoist/thilia/ {
    proxy_pass http://127.0.0.1:8008/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;

    proxy_set_header X-Api-Key __API_KEY_THILIA__;

    proxy_set_header Connection '';
    proxy_buffering off;

    client_max_body_size 1m;
    proxy_read_timeout 60s;
    proxy_connect_timeout 10s;
}
